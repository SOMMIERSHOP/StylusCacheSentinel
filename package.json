{
  "name": "stylus-cache-sentinel",
  "version": "0.1.0",
  "description": "Indexer + automation CLI for Arbitrum Stylus CacheManager bids and evictions",
  "main": "dist/index.js",
  "bin": {
    "sentinel": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "sync": "ts-node src/index.ts sync",
    "status": "ts-node src/index.ts status",
    "reconcile": "ts-node src/index.ts reconcile",
    "run-sentinel": "ts-node src/index.ts run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --test --require ts-node/register test/smoke.test.ts test/cli.test.ts test/sentinel.test.ts",
    "test:e2e": "npm run build && node --test --require ts-node/register test/e2e/mainnet.test.ts",
    "docs:coverage": "node scripts/doc-coverage.js",
    "docs:readability": "node scripts/readability.js",
    "docs:check": "npm run docs:coverage && npm run docs:readability"
  },
  "dependencies": {
    "viem": "^2.21.0",
    "better-sqlite3": "^11.6.0",
    "dotenv": "^16.4.5",
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "ts-node": "^10.9.2",
    "@types/node": "^22.0.0",
    "@types/better-sqlite3": "^7.6.12"
  }
}
